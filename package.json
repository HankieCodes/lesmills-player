{
  "name": "lmplayer",
  "version": "0.2.0",
  "description": "Les Mills Player — align Les Mills release MP3s to teaching videos via audio fingerprinting, then play masterclass + self videos and LRC choreography in sync.",
  "main": "out/electron/main.js",
  "type": "commonjs",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && pnpm bundle",
    "bundle": "esbuild src/renderer/main.tsx --bundle --jsx=automatic --outdir=out/renderer --format=iife --platform=browser --target=chrome124 --minify && node scripts/copy-renderer.mjs",
    "dev": "pnpm build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json",
    "binaries:win": "node scripts/fetch-binaries.mjs win",
    "dist:win": "pnpm binaries:win && pnpm build && electron-builder --win --x64 --publish never",
    "icon": "node scripts/build-icon.mjs",
    "dist:mac": "pnpm binaries:mac && pnpm build && electron-builder --mac --publish never",
    "binaries:mac": "node scripts/fetch-binaries.mjs mac"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.2",
    "electron": "^30.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.9"
  },
  "author": "Hank",
  "build": {
    "appId": "com.brekke-peer.lmplayer",
    "productName": "Les Mills Player",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "executableName": "lmplayer",
      "extraResources": [
        {
          "from": "resources/win",
          "to": "bin",
          "filter": [
            "ffmpeg.exe",
            "fpcalc.exe"
          ]
        }
      ]
    },
    "artifactName": "lmplayer-${version}-${os}-${arch}.${ext}",
    "icon": "resources/icon.png",
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "resources/mac-${arch}",
          "to": "bin",
          "filter": [
            "ffmpeg",
            "fpcalc"
          ]
        }
      ]
    },
    "afterPack": "scripts/after-pack.mjs"
  }
}
